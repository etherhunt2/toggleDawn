{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "ToggleDawn // Operator Command Center",
  "short_name": "ToggleDawn",
  "description": "High-efficiency operator command center with real-time HUD telemetry, biometric quick capture, and spatial mission management.",
  "start_url": "/",
  "id": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#060e1a",
  "theme_color": "#00f0ff",
  "lang": "en",
  "categories": [
    "productivity",
    "utilities",
    "business"
  ],
  "icons": [
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Active Operations",
      "short_name": "Operations",
      "description": "Jump directly to active operations HUD",
      "url": "/#operations",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Tactical Flash Cards",
      "short_name": "Cards",
      "description": "Access active memory recall protocol",
      "url": "/flash-cards",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Captured Vault",
      "short_name": "Vault",
      "description": "View captured and quick-saved field assets",
      "url": "/drafts",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Neural Search",
      "short_name": "Search",
      "description": "Query mission logs and indexed archives",
      "url": "/search",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}

